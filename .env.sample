# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Optional: only needed for direct psql / pg access (not used by the app)
SUPABASE_PASSWORD=your-db-password
# Optional: if set, server-side code uses it instead of the publishable key (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_CHAT_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- RAG tuning ---
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.45
